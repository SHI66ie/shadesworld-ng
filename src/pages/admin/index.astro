---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <script>
    // Simple client-side guard
    if (localStorage.getItem('adminLoggedIn') !== 'true') {
      window.location.href = '/admin/login';
    }
  </script>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-zinc-900 p-6 rounded-2xl border border-zinc-800">
      <h3 class="text-amber-400 text-sm uppercase tracking-widest">Total Products</h3>
      <p class="text-5xl font-bold mt-2" id="product-count">0</p>
    </div>
    <!-- More cards -->
  </div>
  <div class="mt-8">
    <a href="/admin/products" class="inline-block bg-amber-500 text-black px-8 py-3 rounded-xl font-medium">Manage Products</a>
  </div>
</AdminLayout>

<script>
  async function loadStats() {
    try {
      const res = await fetch('/api/products');
      const products = await res.json();
      document.getElementById('product-count').textContent = products.length;
    } catch(e) {}
  }
  loadStats();
</script>