---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Products">
  <div class="flex justify-between items-center mb-8">
    <p class="text-zinc-400">View, add, edit, and remove products from your store.</p>
    <a href="/admin/products/add" class="bg-amber-400 hover:bg-amber-500 text-black px-6 py-2.5 rounded-xl font-semibold flex items-center gap-2 transition">
      <span>+</span> Add Product
    </a>
  </div>

  <!-- Search and Filters -->
  <div class="flex flex-col md:flex-row gap-4 mb-8">
    <div class="flex-1">
      <input type="text" placeholder="Search products..." class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
    </div>
    <select class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition">
      <option value="all">All Categories</option>
      <option value="men">Men</option>
      <option value="women">Women</option>
      <option value="unisex">Unisex</option>
      <option value="optical">Optical Frames</option>
    </select>
  </div>

  <!-- Products Table -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-zinc-950/50 border-b border-zinc-800 text-zinc-400 text-sm">
          <th class="p-4 font-medium w-16">Image</th>
          <th class="p-4 font-medium">Product Name</th>
          <th class="p-4 font-medium">Category</th>
          <th class="p-4 font-medium">Price</th>
          <th class="p-4 font-medium">Stock</th>
          <th class="p-4 font-medium">Status</th>
          <th class="p-4 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <!-- Product Row 1 -->
        <tr class="hover:bg-zinc-800/50 transition">
          <td class="p-4">
            <div class="w-12 h-12 bg-zinc-800 rounded-lg flex items-center justify-center text-xl">🕶️</div>
          </td>
          <td class="p-4">
            <p class="font-medium text-white">Wayfarer Classic</p>
            <p class="text-xs text-zinc-500">SKU: WF-001</p>
          </td>
          <td class="p-4 text-sm text-zinc-400">Unisex</td>
          <td class="p-4 font-medium text-amber-400">₦18,500</td>
          <td class="p-4 text-sm text-zinc-400">24 in stock</td>
          <td class="p-4">
            <span class="bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-full text-xs font-medium">Active</span>
          </td>
          <td class="p-4 text-right">
            <button class="text-zinc-400 hover:text-white transition px-2">Edit</button>
            <button class="text-red-400 hover:text-red-300 transition px-2">Delete</button>
          </td>
        </tr>
        <!-- Product Row 2 -->
        <tr class="hover:bg-zinc-800/50 transition">
          <td class="p-4">
            <div class="w-12 h-12 bg-zinc-800 rounded-lg flex items-center justify-center text-xl">👓</div>
          </td>
          <td class="p-4">
            <p class="font-medium text-white">Aviator Gold</p>
            <p class="text-xs text-zinc-500">SKU: AV-002</p>
          </td>
          <td class="p-4 text-sm text-zinc-400">Men</td>
          <td class="p-4 font-medium text-amber-400">₦22,000</td>
          <td class="p-4 text-sm text-zinc-400">12 in stock</td>
          <td class="p-4">
            <span class="bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-full text-xs font-medium">Active</span>
          </td>
          <td class="p-4 text-right">
            <button class="text-zinc-400 hover:text-white transition px-2">Edit</button>
            <button class="text-red-400 hover:text-red-300 transition px-2">Delete</button>
          </td>
        </tr>
        <!-- Product Row 3 -->
        <tr class="hover:bg-zinc-800/50 transition">
          <td class="p-4">
            <div class="w-12 h-12 bg-zinc-800 rounded-lg flex items-center justify-center text-xl">🕶️</div>
          </td>
          <td class="p-4">
            <p class="font-medium text-white">Cat Eye Vintage</p>
            <p class="text-xs text-zinc-500">SKU: CE-003</p>
          </td>
          <td class="p-4 text-sm text-zinc-400">Women</td>
          <td class="p-4 font-medium text-amber-400">₦15,000</td>
          <td class="p-4 text-sm text-red-400">0 in stock</td>
          <td class="p-4">
            <span class="bg-red-500/10 text-red-400 border border-red-500/20 px-3 py-1 rounded-full text-xs font-medium">Out of Stock</span>
          </td>
          <td class="p-4 text-right">
            <button class="text-zinc-400 hover:text-white transition px-2">Edit</button>
            <button class="text-red-400 hover:text-red-300 transition px-2">Delete</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</AdminLayout>
