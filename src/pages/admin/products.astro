---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';

let products = [];
try {
  const response = await fetch(new URL('/api/products', Astro.url.origin).toString());
  if (response.ok) {
    products = await response.json();
  }
} catch (error) {
  console.error('Failed to fetch products:', error);
  // Fallback: import static products if API fails
  const { products: staticProducts } = await import('../../data/products.ts');
  products = staticProducts;
}
---

<AdminLayout title="Manage Products">
  <div class="flex justify-between items-center mb-8">
    <p class="text-zinc-400">View, add, edit, and remove products from your store.</p>
    <div class="flex items-center gap-3">
      <button id="refreshBtn" class="bg-zinc-800 hover:bg-zinc-700 text-white px-4 py-2.5 rounded-xl font-semibold flex items-center gap-2 transition">
        <span>🔄</span> Refresh
      </button>
      <a href="/admin/products/add" class="bg-amber-400 hover:bg-amber-500 text-black px-6 py-2.5 rounded-xl font-semibold flex items-center gap-2 transition">
        <span>+</span> Add Product
      </a>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="flex flex-col md:flex-row gap-4 mb-8">
    <div class="flex-1">
      <input type="text" id="searchInput" placeholder="Search products..." class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
    </div>
    <select id="categoryFilter" class="bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition">
      <option value="">All Categories</option>
      <option value="Men">Men</option>
      <option value="Women">Women</option>
      <option value="Unisex">Unisex</option>
      <option value="Optical Frames">Optical Frames</option>
    </select>
  </div>

  <!-- Products Table -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-zinc-950/50 border-b border-zinc-800 text-zinc-400 text-sm">
          <th class="p-4 font-medium w-16">Image</th>
          <th class="p-4 font-medium">Product Name</th>
          <th class="p-4 font-medium">Category</th>
          <th class="p-4 font-medium">Price</th>
          <th class="p-4 font-medium">Stock</th>
          <th class="p-4 font-medium">Status</th>
          <th class="p-4 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="productsTableBody" class="divide-y divide-zinc-800">
        <!-- Products will be loaded dynamically here -->
      </tbody>
    </table>
  </div>

  <script>
    let allProducts = [];
    let autoRefreshInterval = null;

    // Load products from API on page load
    async function loadProducts() {
      try {
        const response = await fetch('/api/products');
        if (response.ok) {
          allProducts = await response.json();
          renderProducts(allProducts);
          return true;
        }
      } catch (error) {
        console.error('Error loading products:', error);
      }
      return false;
    }

    function renderProducts(productsToRender) {
      const tbody = document.getElementById('productsTableBody');
      tbody.innerHTML = '';

      if (productsToRender.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-4 text-center text-zinc-400">No products found</td></tr>';
        return;
      }

      productsToRender.forEach((product) => {
        const row = document.createElement('tr');
        row.className = 'hover:bg-zinc-800/50 transition';
        row.setAttribute('data-id', product.id);

        const statusBadge = product.status === 'active'
          ? '<span class="bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-full text-xs font-medium">Active</span>'
          : '<span class="bg-red-500/10 text-red-400 border border-red-500/20 px-3 py-1 rounded-full text-xs font-medium">Out of Stock</span>';

        row.innerHTML = `
          <td class="p-4">
            <div class="w-12 h-12 bg-zinc-800 rounded-lg flex items-center justify-center text-xl">🕶️</div>
          </td>
          <td class="p-4">
            <p class="font-medium text-white">${product.name}</p>
            <p class="text-xs text-zinc-500">SKU: ${product.sku}</p>
          </td>
          <td class="p-4 text-sm text-zinc-400">${product.category}</td>
          <td class="p-4 font-medium text-amber-400">₦${product.price.toLocaleString()}</td>
          <td class="p-4 text-sm text-zinc-400">${product.stock} in stock</td>
          <td class="p-4">${statusBadge}</td>
          <td class="p-4 text-right">
            <button onclick="editProduct(${product.id})" class="text-zinc-400 hover:text-white transition px-2">Edit</button>
            <button onclick="deleteProduct(${product.id})" class="text-red-400 hover:text-red-300 transition px-2">Delete</button>
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    function filterProducts() {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();
      const categoryFilter = document.getElementById('categoryFilter').value;

      const filtered = allProducts.filter((product) => {
        const matchesSearch = product.name.toLowerCase().includes(searchTerm) ||
                              product.sku.toLowerCase().includes(searchTerm) ||
                              product.description.toLowerCase().includes(searchTerm);
        const matchesCategory = !categoryFilter || product.category === categoryFilter;
        return matchesSearch && matchesCategory;
      });

      renderProducts(filtered);
    }

    async function refreshProducts() {
      const btn = document.getElementById('refreshBtn');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span>⏳</span> Refreshing...';
      
      const success = await loadProducts();
      
      btn.disabled = false;
      btn.innerHTML = originalText;
      
      if (success) {
        // Show a brief visual feedback
        btn.classList.add('animate-pulse');
        setTimeout(() => btn.classList.remove('animate-pulse'), 500);
      }
    }

    async function deleteProduct(id) {
      if (!confirm('Are you sure you want to delete this product?')) return;

      try {
        const response = await fetch(`/api/products/${id}`, {
          method: 'DELETE',
        });

        if (response.ok) {
          alert('Product deleted successfully');
          await loadProducts(); // Refresh the list immediately
        } else {
          alert('Failed to delete product');
        }
      } catch (error) {
        console.error('Error deleting product:', error);
        alert('Error deleting product');
      }
    }

    function editProduct(id) {
      window.location.href = `/admin/products/edit?id=${id}`;
    }

    function startAutoRefresh() {
      // Auto-refresh every 30 seconds
      if (autoRefreshInterval) clearInterval(autoRefreshInterval);
      autoRefreshInterval = setInterval(loadProducts, 30000);
    }

    function stopAutoRefresh() {
      if (autoRefreshInterval) {
        clearInterval(autoRefreshInterval);
        autoRefreshInterval = null;
      }
    }

    // Setup event listeners
    document.getElementById('searchInput').addEventListener('input', filterProducts);
    document.getElementById('categoryFilter').addEventListener('change', filterProducts);
    document.getElementById('refreshBtn').addEventListener('click', refreshProducts);

    // Listen for visibility changes to auto-refresh when user returns to the tab
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoRefresh();
      } else {
        loadProducts();
        startAutoRefresh();
      }
    });

    // Load products on page load
    loadProducts();
    startAutoRefresh();

    // Cleanup on page unload
    window.addEventListener('beforeunload', stopAutoRefresh);
  </script>
</AdminLayout>
