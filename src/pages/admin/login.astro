---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Admin Login">
  <div class="max-w-md mx-auto mt-20">
    <div class="bg-zinc-900 p-8 rounded-2xl border border-zinc-800">
      <h1 class="text-3xl font-bold text-center mb-8 text-amber-400">Shades Admin</h1>
      <p id="message" class="text-red-400 text-center mb-6 hidden"></p>
      
      <button 
        onclick="handleLogin()"
        class="w-full bg-amber-500 hover:bg-amber-600 text-black font-semibold py-4 rounded-xl transition text-lg">
        Sign in with Netlify
      </button>
      
      <p class="text-xs text-zinc-500 text-center mt-8">
        Protected area for inventory management
      </p>
    </div>
  </div>
</AdminLayout>

<script>
  function handleLogin() {
    // Redirect to Netlify Identity login
    window.location.href = '/.netlify/identity/login';
  }
</script>