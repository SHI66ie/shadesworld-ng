---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Login - Shades World">
  <div class="min-h-screen bg-gray-50 flex items-center justify-center">
    <div class="max-w-md w-full bg-white p-8 rounded-xl shadow-md">
      <h1 class="text-2xl font-bold text-center mb-6">Admin Login</h1>
      <p id="message" class="text-center text-red-500 mb-4 hidden"></p>
      
      <button onclick="loginWithNetlify()" 
              class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700">
        Login with Netlify Identity
      </button>
      
      <p class="text-xs text-gray-500 text-center mt-6">
        After login, go to <a href="/admin" class="text-blue-600">/admin</a>
      </p>
    </div>
  </div>

  <script>
    async function loginWithNetlify() {
      const messageEl = document.getElementById('message');
      try {
        // Netlify Identity widget or direct
        window.location.href = '/.netlify/identity/login';
      } catch (e) {
        messageEl.textContent = 'Login failed. Ensure Identity is enabled.';
        messageEl.classList.remove('hidden');
      }
    }
  </script>
</Layout>