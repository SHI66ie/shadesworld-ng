---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Add New Product">
  <div class="mb-8 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a href="/admin/products" class="w-10 h-10 bg-zinc-900 border border-zinc-800 rounded-full flex items-center justify-center text-zinc-400 hover:text-white hover:border-zinc-700 transition">
        ←
      </a>
      <p class="text-zinc-400">Fill in the details to add a new product to your catalog.</p>
    </div>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-8 max-w-4xl">
    <form class="space-y-8" action="/admin/products" method="get" onsubmit="alert('Product would be saved to database here!');">
      <!-- Basic Info Section -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4 border-b border-zinc-800 pb-2">Basic Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-zinc-400 mb-2">Product Name</label>
            <input type="text" required placeholder="e.g. Classic Aviator Gold" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-zinc-400 mb-2">Description</label>
            <textarea required rows="4" placeholder="Describe the product details, materials, and styling..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-zinc-400 mb-2">Category</label>
            <select required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition">
              <option value="">Select Category</option>
              <option value="men">Men</option>
              <option value="women">Women</option>
              <option value="unisex">Unisex</option>
              <option value="optical">Optical Frames</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-zinc-400 mb-2">SKU (Stock Keeping Unit)</label>
            <input type="text" placeholder="e.g. AV-GLD-001" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
          </div>
        </div>
      </div>

      <!-- Pricing & Inventory -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4 border-b border-zinc-800 pb-2">Pricing & Inventory</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-zinc-400 mb-2">Price (₦)</label>
            <input type="number" required placeholder="0.00" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-zinc-400 mb-2">Compare at Price (Optional)</label>
            <input type="number" placeholder="0.00" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-zinc-400 mb-2">Stock Quantity</label>
            <input type="number" required placeholder="e.g. 50" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-zinc-400 mb-2">Status</label>
            <select class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition">
              <option value="active">Active (Visible)</option>
              <option value="draft">Draft (Hidden)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Media Section -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4 border-b border-zinc-800 pb-2">Product Media</h3>
        <div class="border-2 border-dashed border-zinc-700 hover:border-amber-400 bg-zinc-950 rounded-2xl p-12 text-center transition cursor-pointer flex flex-col items-center justify-center">
          <span class="text-4xl mb-4">📸</span>
          <p class="text-zinc-300 font-medium mb-1">Click to upload images</p>
          <p class="text-xs text-zinc-500">SVG, PNG, JPG or GIF (max. 800x400px)</p>
        </div>
      </div>

      <div class="flex justify-end gap-4 pt-6 border-t border-zinc-800">
        <a href="/admin/products" class="px-8 py-3 rounded-xl font-semibold bg-zinc-800 text-white hover:bg-zinc-700 transition">
          Cancel
        </a>
        <button type="submit" class="bg-amber-400 text-black px-8 py-3 rounded-xl font-bold hover:bg-amber-500 transition">
          Save Product
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
