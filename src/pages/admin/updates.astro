---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Manage Updates">
  <div class="flex justify-between items-center mb-8">
    <p class="text-zinc-400">Post new updates, changelogs, and announcements for your app.</p>
    <button class="bg-amber-400 hover:bg-amber-500 text-black px-6 py-2.5 rounded-xl font-semibold flex items-center gap-2 transition">
      <span>+</span> New Update
    </button>
  </div>

  <!-- Create Update Form (Initially Hidden, but shown for demo) -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 mb-8">
    <h3 class="text-lg font-bold mb-4">Publish a New Update</h3>
    <form class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-zinc-400 mb-1">Version / Title</label>
        <input type="text" placeholder="e.g. Version 1.3.0 - UI Enhancements" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition" />
      </div>
      <div>
        <label class="block text-sm font-medium text-zinc-400 mb-1">Update Details</label>
        <textarea rows="4" placeholder="Describe what's new in this update..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-400 transition"></textarea>
      </div>
      <div class="flex justify-end">
        <button type="button" class="bg-white text-black px-8 py-3 rounded-xl font-semibold hover:bg-amber-400 transition">
          Publish Update
        </button>
      </div>
    </form>
  </div>

  <!-- Update History -->
  <h3 class="text-lg font-bold mb-4">Update History</h3>
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-zinc-950/50 border-b border-zinc-800 text-zinc-400 text-sm">
          <th class="p-4 font-medium">Title</th>
          <th class="p-4 font-medium">Date</th>
          <th class="p-4 font-medium">Status</th>
          <th class="p-4 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        <tr class="hover:bg-zinc-800/50 transition">
          <td class="p-4">
            <p class="font-medium text-white">Version 1.2.0 - Checkout Added</p>
            <p class="text-xs text-zinc-500 mt-1 truncate max-w-md">Added new secure checkout functionality for smoother transactions.</p>
          </td>
          <td class="p-4 text-sm text-zinc-400">May 17, 2026</td>
          <td class="p-4">
            <span class="bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-full text-xs font-medium">Published</span>
          </td>
          <td class="p-4 text-right">
            <button class="text-zinc-400 hover:text-white transition px-2">Edit</button>
            <button class="text-red-400 hover:text-red-300 transition px-2">Delete</button>
          </td>
        </tr>
        <tr class="hover:bg-zinc-800/50 transition">
          <td class="p-4">
            <p class="font-medium text-white">Version 1.1.0 - New Shades</p>
            <p class="text-xs text-zinc-500 mt-1 truncate max-w-md">Introduced the new Summer collection of premium sunglasses.</p>
          </td>
          <td class="p-4 text-sm text-zinc-400">May 10, 2026</td>
          <td class="p-4">
            <span class="bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-full text-xs font-medium">Published</span>
          </td>
          <td class="p-4 text-right">
            <button class="text-zinc-400 hover:text-white transition px-2">Edit</button>
            <button class="text-red-400 hover:text-red-300 transition px-2">Delete</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</AdminLayout>
