---
import { products } from '../data/products.ts';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop Collection | Shades World</title>
  <meta name="description" content="Discover premium sunglasses and optical frames in Abuja. Shop our exclusive collection of luxury eyewear." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen bg-zinc-950 dark:bg-zinc-100 text-white dark:text-zinc-900 selection:bg-amber-500/30 font-sans flex flex-col">
  <!-- Navbar -->
  <nav class="fixed top-0 w-full bg-zinc-950/60 dark:bg-white/60 backdrop-blur-xl z-50 border-b border-white/5 dark:border-zinc-200 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="flex items-center gap-3 group cursor-pointer">
        <span class="text-3xl group-hover:rotate-12 transition-transform duration-300">🕶️</span>
        <h1 class="text-2xl font-extrabold tracking-tight bg-gradient-to-r from-white via-zinc-200 to-zinc-400 dark:from-zinc-900 dark:via-zinc-700 dark:to-zinc-500 bg-clip-text text-transparent">SHADES WORLD</h1>
      </a>
      <div class="hidden md:flex gap-10 text-sm uppercase tracking-[0.2em] font-medium text-zinc-400 dark:text-zinc-600">
        <a href="/shop" class="text-amber-400 transition-colors duration-300">Shop</a>
        <a href="/#about" class="hover:text-amber-400 transition-colors duration-300">About</a>
        <a href="/#contact" class="hover:text-amber-400 transition-colors duration-300">Contact</a>
      </div>
      <div class="flex items-center gap-4">
        <ThemeToggle />
        <a href="https://wa.me/8074007172" target="_blank" 
           class="bg-white/10 dark:bg-zinc-900 hover:bg-amber-500 px-6 py-2.5 rounded-full text-sm font-semibold flex items-center gap-2 border border-white/10 dark:border-zinc-700 hover:border-amber-400 transition-all duration-300 hover:shadow-[0_0_20px_rgba(245,158,11,0.3)] hover:text-black">
          <span class="text-lg">💬</span> WhatsApp
        </a>
      </div>
    </div>
  </nav>

  <!-- Shop Header -->
  <header class="relative pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden border-b border-white/5 dark:border-zinc-200">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-b from-zinc-900 via-zinc-950/80 to-zinc-950 dark:from-zinc-100 dark:via-zinc-50/80 dark:to-zinc-100"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter mb-6 bg-gradient-to-r from-white via-zinc-200 to-zinc-400 dark:from-zinc-900 dark:via-zinc-700 dark:to-zinc-500 bg-clip-text text-transparent">Our Collection</h1>
      <p class="text-lg md:text-xl text-zinc-400 dark:text-zinc-600 max-w-2xl mx-auto font-light">Explore our premium selection of sunglasses and optical frames curated for your perfect look.</p>
    </div>
    
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-amber-500/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-[120px] pointer-events-none"></div>
  </header>

  <!-- Shop Content -->
  <main class="flex-grow max-w-7xl mx-auto px-6 py-16 flex flex-col lg:flex-row gap-12 w-full relative z-10">
    
    <!-- Filters Sidebar -->
    <aside class="w-full lg:w-1/4 space-y-10">
      <div class="bg-zinc-900/30 dark:bg-zinc-100/30 p-6 rounded-3xl border border-white/5 dark:border-zinc-200">
        <h3 class="text-sm font-bold mb-6 uppercase tracking-[0.2em] text-white dark:text-zinc-900">Categories</h3>
        <ul class="space-y-4">
          <li><a href="#" class="text-amber-400 font-medium flex justify-between items-center group">All Shades <span class="bg-amber-500/10 border border-amber-500/20 text-xs py-1 px-2.5 rounded-full group-hover:bg-amber-500/20 transition-colors">24</span></a></li>
          <li><a href="#" class="text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 transition-colors flex justify-between items-center group">Men <span class="bg-zinc-800 dark:bg-zinc-200 border border-white/5 dark:border-zinc-300 text-xs py-1 px-2.5 rounded-full group-hover:bg-zinc-700 dark:group-hover:bg-zinc-300 transition-colors">8</span></a></li>
          <li><a href="#" class="text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 transition-colors flex justify-between items-center group">Women <span class="bg-zinc-800 dark:bg-zinc-200 border border-white/5 dark:border-zinc-300 text-xs py-1 px-2.5 rounded-full group-hover:bg-zinc-700 dark:group-hover:bg-zinc-300 transition-colors">12</span></a></li>
          <li><a href="#" class="text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 transition-colors flex justify-between items-center group">Unisex <span class="bg-zinc-800 dark:bg-zinc-200 border border-white/5 dark:border-zinc-300 text-xs py-1 px-2.5 rounded-full group-hover:bg-zinc-700 dark:group-hover:bg-zinc-300 transition-colors">4</span></a></li>
          <li><a href="#" class="text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 transition-colors flex justify-between items-center group">Optical Frames <span class="bg-zinc-800 dark:bg-zinc-200 border border-white/5 dark:border-zinc-300 text-xs py-1 px-2.5 rounded-full group-hover:bg-zinc-700 dark:group-hover:bg-zinc-300 transition-colors">6</span></a></li>
        </ul>
      </div>
      
      <div class="bg-zinc-900/30 dark:bg-zinc-100/30 p-6 rounded-3xl border border-white/5 dark:border-zinc-200">
        <h3 class="text-sm font-bold mb-6 uppercase tracking-[0.2em] text-white dark:text-zinc-900">Price Range</h3>
        <ul class="space-y-4">
          <li><label class="flex items-center gap-4 text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 cursor-pointer group transition-colors"><input type="checkbox" class="accent-amber-400 w-4 h-4 bg-zinc-800 dark:bg-zinc-200 border-zinc-700 dark:border-zinc-300 rounded transition-all" /> <span class="group-hover:translate-x-1 transition-transform">Under ₦10,000</span></label></li>
          <li><label class="flex items-center gap-4 text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 cursor-pointer group transition-colors"><input type="checkbox" class="accent-amber-400 w-4 h-4 bg-zinc-800 dark:bg-zinc-200 border-zinc-700 dark:border-zinc-300 rounded transition-all" /> <span class="group-hover:translate-x-1 transition-transform">₦10,000 - ₦20,000</span></label></li>
          <li><label class="flex items-center gap-4 text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 cursor-pointer group transition-colors"><input type="checkbox" class="accent-amber-400 w-4 h-4 bg-zinc-800 dark:bg-zinc-200 border-zinc-700 dark:border-zinc-300 rounded transition-all" /> <span class="group-hover:translate-x-1 transition-transform">₦20,000 - ₦50,000</span></label></li>
          <li><label class="flex items-center gap-4 text-zinc-400 dark:text-zinc-600 hover:text-white dark:hover:text-zinc-900 cursor-pointer group transition-colors"><input type="checkbox" class="accent-amber-400 w-4 h-4 bg-zinc-800 dark:bg-zinc-200 border-zinc-700 dark:border-zinc-300 rounded transition-all" /> <span class="group-hover:translate-x-1 transition-transform">Over ₦50,000</span></label></li>
        </ul>
      </div>
    </aside>

    <!-- Product Grid -->
    <div class="w-full lg:w-3/4">
      
      <div class="flex flex-col sm:flex-row justify-between items-center mb-10 gap-4">
        <p class="text-zinc-400 dark:text-zinc-600 font-light">Showing <span class="text-white dark:text-zinc-900 font-medium">1-6</span> of <span class="text-white dark:text-zinc-900 font-medium">24</span> products</p>
        <div class="relative group">
          <select class="appearance-none bg-zinc-900/80 dark:bg-zinc-100/80 border border-white/10 dark:border-zinc-300 text-white dark:text-zinc-900 rounded-2xl px-6 py-3 pr-12 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400/50 transition-all cursor-pointer backdrop-blur-md">
            <option>Sort by: Featured</option>
            <option>Price: Low to High</option>
            <option>Price: High to Low</option>
            <option>Newest Arrivals</option>
          </select>
          <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-zinc-400 dark:text-zinc-600 group-hover:text-white dark:group-hover:text-zinc-900 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
        {products.map((product) => (
          <div class="group relative rounded-3xl bg-zinc-900/50 dark:bg-zinc-100/50 border border-white/5 dark:border-zinc-200 p-4 hover:bg-zinc-800/50 dark:hover:bg-zinc-200/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
            <div class="relative h-64 rounded-2xl overflow-hidden mb-6 bg-zinc-800 dark:bg-zinc-200">
              <img src={product.image} alt={product.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><rect width=\'100\' height=\'100\' fill=\'%2327272a\'/><text x=\'50\' y=\'50\' font-size=\'40\' text-anchor=\'middle\' dominant-baseline=\'middle\'>🕶️</text></svg>'" />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-transparent to-transparent opacity-60"></div>
              {product.id === 1 && (
                <div class="absolute top-4 left-4 bg-amber-500/20 backdrop-blur-md text-xs font-bold px-3 py-1.5 rounded-full border border-amber-500/30 text-amber-400">
                  BESTSELLER
                </div>
              )}
              {product.id === 4 && (
                <div class="absolute top-4 left-4 bg-red-500/20 backdrop-blur-md text-xs font-bold px-3 py-1.5 rounded-full border border-red-500/30 text-red-400">
                  NEW
                </div>
              )}
            </div>
            <div class="px-2">
              <h4 class="text-xl font-bold text-white dark:text-zinc-900 group-hover:text-amber-400 transition-colors mb-2">{product.name}</h4>
              <div class="flex justify-between items-end">
                <p class="text-2xl font-light tracking-tight">₦{product.price.toLocaleString()}</p>
                <button onclick={`window.open('https://wa.me/8074007172?text=I%20want%20to%20order%20the%20${encodeURIComponent(product.name)}', '_blank')}`} 
                        class="bg-white/10 dark:bg-zinc-900 hover:bg-amber-400 hover:text-black p-3 rounded-xl transition-all duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Pagination -->
      <div class="mt-16 flex justify-center gap-3">
        <button class="w-12 h-12 rounded-2xl flex items-center justify-center bg-amber-400 text-black font-bold shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all">1</button>
        <button class="w-12 h-12 rounded-2xl flex items-center justify-center bg-zinc-900/50 dark:bg-zinc-100/50 border border-white/5 dark:border-zinc-300 text-zinc-400 dark:text-zinc-600 hover:bg-zinc-800 dark:hover:bg-zinc-200 hover:text-white dark:hover:text-zinc-900 transition-all">2</button>
        <button class="w-12 h-12 rounded-2xl flex items-center justify-center bg-zinc-900/50 dark:bg-zinc-100/50 border border-white/5 dark:border-zinc-300 text-zinc-400 dark:text-zinc-600 hover:bg-zinc-800 dark:hover:bg-zinc-200 hover:text-white dark:hover:text-zinc-900 transition-all">3</button>
        <button class="w-12 h-12 rounded-2xl flex items-center justify-center bg-zinc-900/50 dark:bg-zinc-100/50 border border-white/5 dark:border-zinc-300 text-zinc-400 dark:text-zinc-600 hover:bg-zinc-800 dark:hover:bg-zinc-200 hover:text-white dark:hover:text-zinc-900 transition-all">...</button>
        <button class="px-6 h-12 rounded-2xl flex items-center justify-center bg-zinc-900/50 dark:bg-zinc-100/50 border border-white/5 dark:border-zinc-300 text-zinc-400 dark:text-zinc-600 hover:bg-zinc-800 dark:hover:bg-zinc-200 hover:text-white dark:hover:text-zinc-900 transition-all group">
          Next <span class="group-hover:translate-x-1 transition-transform ml-2">→</span>
        </button>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-zinc-950 dark:bg-white py-12 border-t border-white/5 dark:border-zinc-200 mt-auto relative z-10">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-zinc-500 dark:text-zinc-400 text-sm">
      <p>© 2026 Shades World NG • Abuja, Nigeria</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-amber-400 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-amber-400 transition-colors">Terms of Service</a>
      </div>
    </div>
  </footer>
</body>
</html>
