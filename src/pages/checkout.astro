---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Checkout | Shades World</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-white font-sans antialiased">
    <!-- Navbar -->
    <nav class="fixed top-0 w-full bg-black/80 backdrop-blur-md z-50 border-b border-zinc-800">
      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <span class="text-3xl">🕶️</span>
          <a href="/" class="text-2xl font-bold tracking-tight">SHADES WORLD</a>
        </div>
        <a href="/" class="text-sm uppercase tracking-widest hover:text-amber-400 transition">
          Return to Shop
        </a>
      </div>
    </nav>

    <!-- Checkout Main Content -->
    <main class="pt-32 pb-20 max-w-7xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row gap-12">
        
        <!-- Left Column: Forms -->
        <div class="w-full lg:w-2/3 space-y-8">
          <div>
            <h2 class="text-3xl font-bold tracking-tight mb-2">Checkout</h2>
            <p class="text-zinc-400">Complete your details to place the order.</p>
          </div>

          <form class="space-y-8" onsubmit="event.preventDefault(); alert('Order Placed Successfully!');">
            
            <!-- Contact Info -->
            <div class="bg-zinc-900/50 p-8 rounded-3xl border border-zinc-800 backdrop-blur-sm">
              <h3 class="text-xl font-semibold mb-6 flex items-center gap-2">
                <span class="bg-amber-400/10 text-amber-400 w-8 h-8 rounded-full flex items-center justify-center text-sm">1</span>
                Contact Information
              </h3>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-zinc-400 mb-2">Email Address</label>
                  <input type="email" required placeholder="you@example.com" 
                         class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-zinc-400 mb-2">Phone Number</label>
                  <input type="tel" required placeholder="+234 ..." 
                         class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition" />
                </div>
              </div>
            </div>

            <!-- Shipping Info -->
            <div class="bg-zinc-900/50 p-8 rounded-3xl border border-zinc-800 backdrop-blur-sm">
              <h3 class="text-xl font-semibold mb-6 flex items-center gap-2">
                <span class="bg-amber-400/10 text-amber-400 w-8 h-8 rounded-full flex items-center justify-center text-sm">2</span>
                Shipping Details
              </h3>
              <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">First Name</label>
                    <input type="text" required placeholder="John" 
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Last Name</label>
                    <input type="text" required placeholder="Doe" 
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-zinc-400 mb-2">Delivery Address</label>
                  <input type="text" required placeholder="Street Address, Area" 
                         class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">City/State</label>
                    <input type="text" required placeholder="Abuja" 
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-zinc-400 mb-2">Postal Code</label>
                    <input type="text" placeholder="Optional" 
                           class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400 transition" />
                  </div>
                </div>
              </div>
            </div>

            <!-- Payment Method -->
            <div class="bg-zinc-900/50 p-8 rounded-3xl border border-zinc-800 backdrop-blur-sm">
              <h3 class="text-xl font-semibold mb-6 flex items-center gap-2">
                <span class="bg-amber-400/10 text-amber-400 w-8 h-8 rounded-full flex items-center justify-center text-sm">3</span>
                Payment Method
              </h3>
              <div class="space-y-3">
                <label class="flex items-center gap-4 p-4 rounded-xl border border-amber-400/50 bg-amber-400/5 cursor-pointer transition hover:bg-amber-400/10">
                  <input type="radio" name="payment" value="transfer" checked class="w-5 h-5 text-amber-400 focus:ring-amber-400 bg-zinc-900 border-zinc-700" />
                  <div>
                    <div class="font-medium">Bank Transfer</div>
                    <div class="text-sm text-zinc-400 mt-1">Pay securely via bank transfer</div>
                  </div>
                </label>
                <label class="flex items-center gap-4 p-4 rounded-xl border border-zinc-800 bg-zinc-950 cursor-pointer transition hover:border-zinc-700">
                  <input type="radio" name="payment" value="paystack" class="w-5 h-5 text-amber-400 focus:ring-amber-400 bg-zinc-900 border-zinc-700" />
                  <div>
                    <div class="font-medium">Card Payment (Paystack)</div>
                    <div class="text-sm text-zinc-400 mt-1">Visa, Mastercard, Verve</div>
                  </div>
                </label>
              </div>
            </div>

            <button type="submit" class="w-full bg-white text-black py-4 rounded-2xl text-lg font-bold hover:bg-amber-400 transition duration-300 shadow-lg shadow-white/10 hover:shadow-amber-400/20">
              Complete Purchase
            </button>
            <p class="text-center text-sm text-zinc-500 flex items-center justify-center gap-2">
              <span>🔒</span> Secure encrypted checkout
            </p>
          </form>
        </div>

        <!-- Right Column: Order Summary -->
        <div class="w-full lg:w-1/3">
          <div class="bg-zinc-900/80 p-8 rounded-3xl border border-zinc-800 sticky top-32 backdrop-blur-md">
            <h3 class="text-xl font-semibold mb-6">Order Summary</h3>
            
            <div class="space-y-4 mb-6">
              <!-- Item 1 -->
              <div class="flex gap-4">
                <div id="summaryImage" class="w-20 h-20 bg-zinc-800 rounded-xl flex items-center justify-center text-3xl overflow-hidden">🕶️</div>
                <div class="flex-1 flex flex-col justify-center">
                  <h4 id="summaryName" class="font-medium">Wayfarer Classic</h4>
                  <p class="text-sm text-zinc-400 mt-1">Qty: 1</p>
                  <p id="summaryPrice" class="font-semibold text-amber-400 mt-1">₦18,500</p>
                </div>
              </div>
            </div>

            <div class="border-t border-zinc-800 pt-6 space-y-4">
              <div class="flex justify-between text-zinc-400">
                <span>Subtotal</span>
                <span id="summarySubtotal">₦18,500</span>
              </div>
              <div class="flex justify-between text-zinc-400">
                <span>Shipping</span>
                <span>₦2,500</span>
              </div>
              <div class="flex justify-between text-zinc-400">
                <span>Taxes</span>
                <span>₦0</span>
              </div>
            </div>

            <div class="border-t border-zinc-800 mt-6 pt-6">
              <div class="flex justify-between items-end">
                <span class="text-lg font-medium">Total</span>
                <span id="summaryTotal" class="text-3xl font-bold text-white">₦21,000</span>
              </div>
            </div>

            <script>
              // Load correct product based on query parameter
              async function loadProduct() {
                const urlParams = new URLSearchParams(window.location.search);
                const id = urlParams.get('id');
                if (!id) return;

                try {
                  const response = await fetch(`/api/products/${id}`);
                  if (response.ok) {
                    const product = await response.json();
                    
                    // Update name
                    const nameEl = document.getElementById('summaryName');
                    if (nameEl) nameEl.textContent = product.name;
                    
                    // Update price in summary
                    const priceEl = document.getElementById('summaryPrice');
                    if (priceEl) priceEl.textContent = `₦${product.price.toLocaleString()}`;
                    
                    // Update subtotal
                    const subtotalEl = document.getElementById('summarySubtotal');
                    if (subtotalEl) subtotalEl.textContent = `₦${product.price.toLocaleString()}`;
                    
                    // Update total
                    const totalEl = document.getElementById('summaryTotal');
                    if (totalEl) totalEl.textContent = `₦${(product.price + 2500).toLocaleString()}`;
                    
                    // Update image
                    const imageEl = document.getElementById('summaryImage');
                    if (imageEl) {
                      imageEl.innerHTML = `<img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover" onerror="this.outerHTML='🕶️'" />`;
                    }
                  }
                } catch (error) {
                  console.error('Error fetching product for checkout:', error);
                }
              }

              // Run on load
              loadProduct();
            </script>
            
            <!-- Trust Badges -->
            <div class="mt-8 pt-6 border-t border-zinc-800/50 flex flex-wrap gap-4 justify-center">
               <span class="text-xs font-medium text-zinc-500 uppercase tracking-wider">Fast Delivery</span>
               <span class="text-xs font-medium text-zinc-500 uppercase tracking-wider">•</span>
               <span class="text-xs font-medium text-zinc-500 uppercase tracking-wider">Quality Guaranteed</span>
            </div>
          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-black py-8 border-t border-zinc-800">
      <div class="max-w-7xl mx-auto px-6 text-center text-zinc-500 text-sm">
        <p>© 2026 Shades World NG • Abuja, Nigeria</p>
      </div>
    </footer>
  </body>
</html>
