---
---

<div class="min-h-screen bg-zinc-950 text-white">
  <!-- Navbar -->
  <nav class="fixed top-0 w-full bg-black/80 backdrop-blur-md z-50 border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <span class="text-3xl">🕶️</span>
        <h1 class="text-2xl font-bold tracking-tight">SHADES WORLD</h1>
      </div>
      <div class="hidden md:flex gap-8 text-sm uppercase tracking-widest">
        <a href="/shop" class="hover:text-amber-400 transition">Shop</a>
        <a href="#about" class="hover:text-amber-400 transition">About</a>
        <a href="#contact" class="hover:text-amber-400 transition">Contact</a>
      </div>
      <a href="https://wa.me/2349112014959" target="_blank" 
         class="bg-green-500 hover:bg-green-600 px-6 py-2 rounded-full text-sm font-medium flex items-center gap-2">
        <span>💬</span> WhatsApp
      </a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-24 pb-20 bg-gradient-to-br from-zinc-900 to-black">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h2 class="text-6xl md:text-7xl font-bold tracking-tighter mb-6">SHADE YOUR WORLD</h2>
      <p class="text-xl md:text-2xl text-zinc-400 max-w-2xl mx-auto mb-10">Premium Sunglasses & Optical Frames in Abuja</p>
      <a href="/shop" class="inline-block bg-white text-black px-10 py-4 rounded-full text-lg font-semibold hover:bg-amber-400 transition">Shop Collection</a>
    </div>
  </section>

  <!-- Products -->
  <section id="shop" class="py-20 bg-zinc-900">
    <div class="max-w-7xl mx-auto px-6">
      <h3 class="text-4xl font-bold text-center mb-12">Featured Shades</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Products will go here -->
        <div class="bg-zinc-800 rounded-3xl overflow-hidden group">
          <div class="h-80 bg-zinc-700 flex items-center justify-center text-6xl">🕶️</div>
          <div class="p-6">
            <h4 class="text-xl font-semibold">Wayfarer Classic</h4>
            <p class="text-amber-400 text-2xl font-bold mt-1">₦18,500</p>
            <a href="/checkout" 
                    class="mt-6 w-full block text-center bg-white text-black py-3 rounded-2xl font-medium hover:bg-amber-400 transition">
              Buy Now
            </a>
          </div>
        </div>
        <!-- Add more cards similarly -->
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-black py-12 border-t border-zinc-800">
    <div class="max-w-7xl mx-auto px-6 text-center text-zinc-500 text-sm">
      <p>© 2026 Shades World NG • Abuja, Nigeria</p>
      <p class="mt-2">Suite S005, KingFem Plaza • +234 911 201 4959</p>
    </div>
  </footer>
</div>